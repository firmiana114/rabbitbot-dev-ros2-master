# Keep this repository focused on source, scripts, and project metadata.
*
!*/

# Source and scripts
!*.py
!*.pyi
!*.sh
!*.bash
!*.launch.py
!*.cpp
!*.hpp

# Project metadata, configs, and docs
!.gitignore
!README.md
!*.md
!*.toml
!project_config.json
!kuavo_configs.json
!pyrightconfig.json
!*.yaml
!*.yml
!*.ini
!*.cfg
!*.conf
!*.xml
!requirements*.txt
!constraints*.txt
!Dockerfile
!docker-compose*.yml
!Makefile

# Python caches and build outputs
__pycache__/
*.py[cod]
*$py.class
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
htmlcov/

# Local environments and vendored dependency trees
.env
.env.*
.venv/
venv/
env/
ENV/
py310/
py310.backup_*/
py38/
__pypackages__/

# Runtime outputs and local data
logs/
log/
Log/
data/
workspace/
install/
examples/
3rdparty/
rabbitbot/robots/image_buffer/
**/workspace/tools/

# Generated files, media, archives, and databases
*.log
*.ans
*.jpg
*.jpeg
*.png
*.wav
*.mp3
*.mp4
*.bag
*.db
*.sqlite
*.sqlite3
*.tar
*.tar.gz
*.zip
*.so
*.onnx
*.pt
*.pth
*.ckpt
